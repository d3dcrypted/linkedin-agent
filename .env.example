# Copy to .env and fill in. Never commit the real .env (it is git-ignored).
# lnkd.py reads this file (or ~/.hermes/.env) via load_env().

# Drafting LLM. Required by lnkd.py. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Overrides the default drafting model.
OPENROUTER_MODEL=openai/gpt-oss-120b

# Search + full-text extract for lnkd.py's research stage. Free tier 1000/month.
# Key at https://tavily.com . Without it, lnkd.py falls back to keyless
# DuckDuckGo, which is frequently blocked. To make the Hermes skill's
# web_extract work too, also set `web.extract_backend: tavily` in config.yaml.
TAVILY_API_KEY=
